OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
PROFILE_BUILDER_MODEL=llama-3.3-70b-versatile
PROFILE_BUILDER_PREVIEW_ROOT=data/profile_builder_preview

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=talent_intelligence
DATA_BACKEND=artifacts
ALLOW_ARTIFACT_FALLBACK=true
MATCHING_MODE=artifact
LIVE_MATCHING_TOP_N=50
LIVE_MATCHING_TOP_K=5
FAISS_INDEX_PATH=data/indexes/faiss/cv_index.faiss
FAISS_ID_MAP_PATH=data/indexes/faiss/id_map.pkl
MONGODB_COLLECTION=profiles
MONGODB_CANDIDATES_COLLECTION=candidates
MONGODB_CANDIDATE_PROFILES_COLLECTION=candidate_profiles
MONGODB_JOB_PROFILES_COLLECTION=job_profiles
MONGODB_MATCHING_RUNS_COLLECTION=matching_runs
MONGODB_DECISION_CARDS_COLLECTION=decision_cards
MONGODB_RUNS_COLLECTION=profile_builder_runs

MODULE1_RAW_ROOT=data/raw_cv
MODULE1_OUT_ROOT=data/processed
MODULE1_REPORT_PATH=data/processed/module1_pipeline_report.json
MODULE1_ACCEPTED_PATH=data/processed/handoff/accepted.json

RAPIDOCR_MODEL_DIR=
OCR_CONF_THRESHOLD=28.0
OCR_LOW_CONF_WARNING_THRESHOLD=35.0
PDF_NATIVE_MIN_WORDS_FOR_TEXT_ONLY=200
SECONDARY_TESSERACT_PSMS=6,11

OCR_BENCHMARK_TESSERACT_LANG=eng+fra
OCR_BENCHMARK_EASYOCR_LANGS=en,fr
OCR_BENCHMARK_TROCR_MODEL=microsoft/trocr-base-printed
OCR_BENCHMARK_TROCR_MAX_NEW_TOKENS=512
OCR_BENCHMARK_PDF_DPI=200
OCR_BENCHMARK_MISTRAL_MODEL=mistral-ocr-latest
MISTRAL_API_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
SMART_RECRUITER_API_BASE_URL=http://localhost:8000
AUTH_ENABLED=false
SMART_RECRUITER_API_KEY=change-me
API_KEY_HEADER=X-Smart-Recruiter-Key

